<%- include('../partials/header') %>
<div class="page-heading"><div><div class="eyebrow">DANH MỤC ĐÀO TẠO</div><h1>Quản lý môn học</h1><p>Quản lý học phần, số tín chỉ và kết quả theo môn học.</p></div><a class="button button-primary" href="/subjects/new">＋ Thêm môn học</a></div>
<section class="panel"><form class="filter-bar" action="/subjects" method="get"><div class="search-field"><label class="sr-only" for="q">Tìm môn học</label><span aria-hidden="true">⌕</span><input id="q" name="q" value="<%= query.q || '' %>" placeholder="Tìm theo mã môn, tên môn..."></div><button class="button button-primary" type="submit">Tìm kiếm</button><% if (query.q) { %><a class="button button-light" href="/subjects">Xóa lọc</a><% } %></form><div class="list-summary"><strong>Danh sách môn học</strong><span><%= subjects.length %> kết quả</span></div><div class="table-wrap"><table><thead><tr><th>STT</th><th>Mã môn học</th><th>Tên môn học</th><th>Số tín chỉ</th><th>Bản ghi điểm</th><th class="text-right">Thao tác</th></tr></thead><tbody><% if (!subjects.length) { %><tr><td colspan="6"><div class="empty-state"><span aria-hidden="true">▤</span><strong>Không tìm thấy môn học</strong><p>Thử thay đổi từ khóa hoặc thêm một môn học mới.</p><a class="button button-light" href="/subjects/new">＋ Thêm môn học</a></div></td></tr><% } %><% subjects.forEach((item,index) => { %><tr><td class="muted"><%= index + 1 %></td><td><span class="code-text"><%= item.code %></span></td><td><strong><%= item.name %></strong></td><td><span class="badge badge-purple"><%= item.credits %> tín chỉ</span></td><td><a class="text-link" href="/scores?subject_id=<%= item.id %>"><%= item.score_count %> bản ghi</a></td><td><div class="row-actions"><a class="button button-small button-light" href="/subjects/<%= item.id %>/edit" aria-label="Sửa môn <%= item.name %>">Sửa</a><form action="/subjects/<%= item.id %>/delete" method="post" data-confirm="Bạn có chắc muốn xóa môn học <%= item.name %>? Môn học có điểm số sẽ không thể xóa."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-danger" type="submit" aria-label="Xóa môn <%= item.name %>">Xóa</button></form></div></td></tr><% }) %></tbody></table></div></section>
<div class="info-note"><span aria-hidden="true">ⓘ</span> Số tín chỉ được dùng để tính điểm trung bình học tập của sinh viên.</div>
<%- include('../partials/footer') %>
