<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#123f40">
  <title><%= title %> · Quản lý sinh viên</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/app.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Chuyển đến nội dung</a>
  <div class="app-layout">
    <aside class="sidebar" aria-label="Điều hướng chính">
      <a class="brand" href="/" aria-label="QLSV – Trang tổng quan">
        <span class="brand-symbol" aria-hidden="true">Q</span>
        <span><strong>QLSV<span class="brand-dot">.</span></strong><small>QUẢN LÝ SINH VIÊN</small></span>
      </a>
      <div class="nav-label">KHÔNG GIAN QUẢN LÝ</div>
      <nav class="main-nav">
        <a href="/" class="nav-item <%= path === '/' ? 'active' : '' %>" <%- path === '/' ? 'aria-current="page"' : '' %>><span class="nav-icon" aria-hidden="true">◈</span> Tổng quan</a>
        <a href="/students" class="nav-item <%= path.startsWith('/students') ? 'active' : '' %>" <%- path.startsWith('/students') ? 'aria-current="page"' : '' %>><span class="nav-icon" aria-hidden="true">♙</span> Sinh viên</a>
        <a href="/classes" class="nav-item <%= path.startsWith('/classes') ? 'active' : '' %>" <%- path.startsWith('/classes') ? 'aria-current="page"' : '' %>><span class="nav-icon" aria-hidden="true">▦</span> Lớp học</a>
        <a href="/subjects" class="nav-item <%= path.startsWith('/subjects') ? 'active' : '' %>" <%- path.startsWith('/subjects') ? 'aria-current="page"' : '' %>><span class="nav-icon" aria-hidden="true">▤</span> Môn học</a>
        <a href="/scores" class="nav-item <%= path.startsWith('/scores') ? 'active' : '' %>" <%- path.startsWith('/scores') ? 'aria-current="page"' : '' %>><span class="nav-icon" aria-hidden="true">▥</span> Điểm số</a>
      </nav>
      <div class="sidebar-note"><span class="status-dot" aria-hidden="true"></span> Giai đoạn 01<span>Không gian demo tại localhost</span></div>
      <div class="sidebar-author"><div class="avatar">C</div><div><strong>Trần Đức Công</strong><small>DTC245200418 · CNTT K23I</small></div></div>
    </aside>
    <div class="main-shell">
      <header class="topbar"><div class="breadcrumb">Hệ thống quản lý <span aria-hidden="true">/</span> <strong><%= title %></strong></div><span class="topbar-badge">ICTU · Giai đoạn 1</span></header>
      <main id="main-content" class="content">
        <% if (success) { %><div class="alert alert-success" role="status"><span aria-hidden="true">✓</span><span><%= success %></span></div><% } %>
        <% if (error) { %><div class="alert alert-error" role="alert"><span aria-hidden="true">!</span><span><%= error %></span></div><% } %>
