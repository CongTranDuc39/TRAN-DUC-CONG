<%- include('../partials/header') %>
<div class="page-heading"><div><div class="eyebrow">TỔ CHỨC ĐÀO TẠO</div><h1>Quản lý lớp học</h1><p>Tổ chức lớp học và theo dõi số lượng sinh viên.</p></div><a class="button button-primary" href="/classes/new">＋ Thêm lớp học</a></div>
<section class="panel"><form class="filter-bar" action="/classes" method="get"><div class="search-field"><label class="sr-only" for="q">Tìm lớp học</label><span aria-hidden="true">⌕</span><input id="q" name="q" value="<%= query.q || '' %>" placeholder="Tìm theo mã lớp, tên lớp..."></div><button class="button button-primary" type="submit">Tìm kiếm</button><% if (query.q) { %><a class="button button-light" href="/classes">Xóa lọc</a><% } %></form><div class="list-summary"><strong>Danh sách lớp học</strong><span><%= classes.length %> kết quả</span></div><div class="table-wrap"><table><thead><tr><th>STT</th><th>Mã lớp</th><th>Tên lớp</th><th>Niên khóa</th><th>Sinh viên</th><th class="text-right">Thao tác</th></tr></thead><tbody><% if (!classes.length) { %><tr><td colspan="6"><div class="empty-state"><span aria-hidden="true">▦</span><strong>Không tìm thấy lớp học</strong><p>Thử thay đổi từ khóa hoặc thêm một lớp học mới.</p><a class="button button-light" href="/classes/new">＋ Thêm lớp học</a></div></td></tr><% } %><% classes.forEach((item,index) => { %><tr><td class="muted"><%= index + 1 %></td><td><span class="code-text"><%= item.code %></span></td><td><strong><%= item.name %></strong></td><td><%= item.school_year %></td><td><a class="badge badge-neutral" href="/students?class_id=<%= item.id %>"><%= item.student_count %> sinh viên</a></td><td><div class="row-actions"><a class="button button-small button-light" href="/classes/<%= item.id %>/edit" aria-label="Sửa lớp <%= item.name %>">Sửa</a><form action="/classes/<%= item.id %>/delete" method="post" data-confirm="Bạn có chắc muốn xóa lớp <%= item.name %>? Lớp có sinh viên sẽ không thể xóa."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-danger" type="submit" aria-label="Xóa lớp <%= item.name %>">Xóa</button></form></div></td></tr><% }) %></tbody></table></div></section>
<div class="info-note"><span aria-hidden="true">ⓘ</span> Chỉ có thể xóa lớp học khi không còn sinh viên trong lớp.</div>
<%- include('../partials/footer') %>
