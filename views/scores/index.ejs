<%- include('../partials/header') %>
<div class="page-heading"><div><div class="eyebrow">KẾT QUẢ HỌC TẬP</div><h1>Quản lý điểm số</h1><p>Nhập điểm thành phần, tra cứu và tính tổng kết tự động.</p></div><a class="button button-primary" href="/scores/new">＋ Nhập điểm</a></div>
<section class="score-summary" aria-label="Thống kê kết quả theo bộ lọc"><div><span>Bản ghi điểm</span><strong><%= summary.count %></strong></div><div><span>Điểm trung bình</span><strong><%= formatScore(summary.average) %><small>/ 10</small></strong></div><div><span>Đạt (từ 5 điểm)</span><strong class="success-text"><%= summary.passed %></strong></div><div><span>Chưa đạt (dưới 5 điểm)</span><strong class="danger-text"><%= summary.failed %></strong></div></section>
<section class="panel"><form class="filter-bar score-filters" action="/scores" method="get"><div class="search-field"><label class="sr-only" for="q">Tìm bảng điểm</label><span aria-hidden="true">⌕</span><input id="q" name="q" value="<%= query.q || '' %>" placeholder="Mã sinh viên, tên, môn học..."></div><div class="filter-field"><label class="sr-only" for="class_id">Lọc theo lớp</label><select id="class_id" name="class_id"><option value="">Tất cả lớp học</option><% classes.forEach(item => { %><option value="<%= item.id %>" <%= isSelected(query.class_id,item.id) ? 'selected' : '' %>><%= item.name %></option><% }) %></select></div><div class="filter-field"><label class="sr-only" for="student_id">Lọc theo sinh viên</label><select id="student_id" name="student_id"><option value="">Tất cả sinh viên</option><% students.forEach(item => { %><option value="<%= item.id %>" <%= isSelected(query.student_id,item.id) ? 'selected' : '' %>><%= item.student_code %> · <%= item.full_name %></option><% }) %></select></div><div class="filter-field"><label class="sr-only" for="subject_id">Lọc theo môn học</label><select id="subject_id" name="subject_id"><option value="">Tất cả môn học</option><% subjects.forEach(item => { %><option value="<%= item.id %>" <%= isSelected(query.subject_id,item.id) ? 'selected' : '' %>><%= item.name %></option><% }) %></select></div><div class="filter-field filter-small"><label class="sr-only" for="semester">Lọc theo học kỳ</label><select id="semester" name="semester"><option value="">Tất cả học kỳ</option><% [1,2,3].forEach(item => { %><option value="<%= item %>" <%= isSelected(query.semester,item) ? 'selected' : '' %>>Học kỳ <%= item %></option><% }) %></select></div><div class="filter-field filter-small"><label class="sr-only" for="academic_year">Lọc theo năm học</label><input id="academic_year" name="academic_year" value="<%= query.academic_year || '' %>" placeholder="Năm học: 2024-2025" maxlength="20"></div><button class="button button-primary" type="submit">Áp dụng bộ lọc</button><a class="button button-light" href="/scores">Xóa lọc</a></form><div class="list-summary"><strong>Bảng điểm sinh viên</strong><span><%= scores.length %> kết quả</span></div><div class="table-wrap"><table class="score-table"><thead><tr><th>Sinh viên</th><th>Môn học</th><th>Học kỳ / Năm học</th><th class="text-center">Chuyên cần<br><small>10%</small></th><th class="text-center">Giữa kỳ<br><small>30%</small></th><th class="text-center">Cuối kỳ<br><small>60%</small></th><th class="text-center">Tổng kết</th><th class="text-right">Thao tác</th></tr></thead><tbody><% if (!scores.length) { %><tr><td colspan="8"><div class="empty-state"><span aria-hidden="true">▥</span><strong>Không tìm thấy bản ghi điểm</strong><p>Thử thay đổi bộ lọc hoặc nhập điểm cho sinh viên.</p><a class="button button-light" href="/scores/new">＋ Nhập điểm</a></div></td></tr><% } %><% scores.forEach(item => { %><tr><td><strong><%= item.full_name %></strong><span class="cell-subtext code-text"><%= item.student_code %></span><span class="cell-subtext"><%= item.class_name || 'Chưa xếp lớp' %></span></td><td><strong><%= item.subject_name %></strong><span class="cell-subtext code-text"><%= item.subject_code %></span><span class="cell-subtext"><%= item.credits %> tín chỉ</span></td><td>Học kỳ <%= item.semester %><span class="cell-subtext"><%= item.academic_year %></span></td><td class="text-center"><%= formatScore(item.attendance_score) %></td><td class="text-center"><%= formatScore(item.midterm_score) %></td><td class="text-center"><%= formatScore(item.final_score) %></td><td class="text-center"><span class="badge <%= Number(item.total_score) >= 5 ? 'badge-success' : 'badge-danger' %>"><%= formatScore(item.total_score) %></span><span class="cell-subtext"><%= Number(item.total_score) >= 5 ? 'Đạt' : 'Chưa đạt' %></span></td><td><div class="row-actions"><a class="button button-small button-light" href="/scores/<%= item.id %>/edit" aria-label="Sửa điểm môn <%= item.subject_name %> của <%= item.full_name %>">Sửa</a><form action="/scores/<%= item.id %>/delete" method="post" data-confirm="Bạn có chắc muốn xóa điểm môn <%= item.subject_name %> của sinh viên <%= item.full_name %>?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-danger" type="submit" aria-label="Xóa điểm môn <%= item.subject_name %> của <%= item.full_name %>">Xóa</button></form></div></td></tr><% }) %></tbody></table></div></section>
<div class="info-note"><span aria-hidden="true">ⓘ</span> Tổng kết = Chuyên cần × 10% + Giữa kỳ × 30% + Cuối kỳ × 60%. Điểm trung bình phía trên có trọng số tín chỉ, tính trên các bản ghi trong bộ lọc.</div>
<%- include('../partials/footer') %>
