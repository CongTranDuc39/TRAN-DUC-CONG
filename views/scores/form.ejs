<%- include('../partials/header') %>
<div class="page-heading"><div><a class="back-link" href="/scores">← Bảng điểm sinh viên</a><h1><%= heading %></h1><p>Chọn sinh viên, môn học và nhập điểm thành phần theo thang 10.</p></div></div>
<div class="form-layout"><section class="panel form-panel"><div class="panel-heading"><div><h2>Thông tin điểm số</h2><p>Các trường có dấu <span class="required">*</span> là bắt buộc.</p></div></div><form action="<%= action %>" method="post" class="data-form" data-score-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div class="field field-full"><label for="student_id">Sinh viên <span class="required">*</span></label><select id="student_id" name="student_id" required <%- errors.student_id ? 'aria-invalid="true" aria-describedby="student-id-error"' : '' %>><option value="">Chọn sinh viên</option><% students.forEach(item => { %><option value="<%= item.id %>" <%= isSelected(values.student_id,item.id) ? 'selected' : '' %>><%= item.student_code %> · <%= item.full_name %></option><% }) %></select><% if (errors.student_id) { %><small class="field-error" id="student-id-error"><%= errors.student_id %></small><% } %><% if (!students.length) { %><small class="field-hint">Chưa có sinh viên. <a class="text-link" href="/students/new">Thêm sinh viên trước khi nhập điểm.</a></small><% } %></div><div class="field field-full"><label for="subject_id">Môn học <span class="required">*</span></label><select id="subject_id" name="subject_id" required <%- errors.subject_id ? 'aria-invalid="true" aria-describedby="subject-id-error"' : '' %>><option value="">Chọn môn học</option><% subjects.forEach(item => { %><option value="<%= item.id %>" <%= isSelected(values.subject_id,item.id) ? 'selected' : '' %>><%= item.code %> · <%= item.name %></option><% }) %></select><% if (errors.subject_id) { %><small class="field-error" id="subject-id-error"><%= errors.subject_id %></small><% } %><% if (!subjects.length) { %><small class="field-hint">Chưa có môn học. <a class="text-link" href="/subjects/new">Thêm môn học trước khi nhập điểm.</a></small><% } %></div><div class="field"><label for="semester">Học kỳ <span class="required">*</span></label><select id="semester" name="semester" required <%- errors.semester ? 'aria-invalid="true" aria-describedby="semester-error"' : '' %>><option value="">Chọn học kỳ</option><% [1,2,3].forEach(item => { %><option value="<%= item %>" <%= isSelected(values.semester,item) ? 'selected' : '' %>>Học kỳ <%= item %></option><% }) %></select><% if (errors.semester) { %><small class="field-error" id="semester-error"><%= errors.semester %></small><% } %></div><div class="field"><label for="academic_year">Năm học <span class="required">*</span></label><input id="academic_year" name="academic_year" value="<%= values.academic_year || '' %>" placeholder="VD: 2024-2025" maxlength="20" required <%- errors.academic_year ? 'aria-invalid="true" aria-describedby="academic-year-error"' : '' %>><% if (errors.academic_year) { %><small class="field-error" id="academic-year-error"><%= errors.academic_year %></small><% } %></div></div><div class="form-section-title"><h3>Điểm thành phần</h3><span>Thang điểm 0 – 10</span></div><div class="form-grid score-inputs"><div class="field"><label for="attendance_score">Chuyên cần <span class="required">*</span><span class="weight-label">10%</span></label><input id="attendance_score" name="attendance_score" type="number" value="<%= values.attendance_score ?? '' %>" placeholder="0,0" min="0" max="10" step="0.01" inputmode="decimal" required data-score-input <%- errors.attendance_score ? 'aria-invalid="true" aria-describedby="attendance-score-error"' : '' %>><% if (errors.attendance_score) { %><small class="field-error" id="attendance-score-error"><%= errors.attendance_score %></small><% } %></div><div class="field"><label for="midterm_score">Giữa kỳ <span class="required">*</span><span class="weight-label">30%</span></label><input id="midterm_score" name="midterm_score" type="number" value="<%= values.midterm_score ?? '' %>" placeholder="0,0" min="0" max="10" step="0.01" inputmode="decimal" required data-score-input <%- errors.midterm_score ? 'aria-invalid="true" aria-describedby="midterm-score-error"' : '' %>><% if (errors.midterm_score) { %><small class="field-error" id="midterm-score-error"><%= errors.midterm_score %></small><% } %></div><div class="field"><label for="final_score">Cuối kỳ <span class="required">*</span><span class="weight-label">60%</span></label><input id="final_score" name="final_score" type="number" value="<%= values.final_score ?? '' %>" placeholder="0,0" min="0" max="10" step="0.01" inputmode="decimal" required data-score-input <%- errors.final_score ? 'aria-invalid="true" aria-describedby="final-score-error"' : '' %>><% if (errors.final_score) { %><small class="field-error" id="final-score-error"><%= errors.final_score %></small><% } %></div></div><div class="score-preview"><div><strong>Điểm tổng kết dự kiến</strong><span>Tự động tính theo trọng số 10% · 30% · 60%</span></div><output data-score-output aria-live="polite">—</output></div><div class="form-actions"><a class="button button-light" href="/scores">Hủy</a><button class="button button-primary" type="submit">Lưu điểm số</button></div></form></section><aside class="form-aside"><span class="aside-illustration" aria-hidden="true">▥</span><h2>Tổng kết chính xác, tự động</h2><p>Điểm tổng kết được tính và làm tròn đến hai chữ số thập phân khi lưu.</p><div class="formula-card"><strong>Công thức tính điểm</strong><div>Chuyên cần <b>× 10%</b></div><div>Giữa kỳ <b>× 30%</b></div><div>Cuối kỳ <b>× 60%</b></div><hr><div>Điểm tổng kết <b>/ 10</b></div></div><div class="info-note">Mỗi sinh viên chỉ có một bản ghi cho cùng môn học, học kỳ và năm học. Điểm từ 5 được xem là đạt trong bản demo.</div></aside></div>
<%- include('../partials/footer') %>
