<%- include('../partials/header') %>
<div class="page-heading"><div><div class="eyebrow">HỒ SƠ SINH VIÊN</div><h1>Quản lý sinh viên</h1><p>Tra cứu thông tin, phân lớp và theo dõi kết quả học tập.</p></div><a class="button button-primary" href="/students/new">＋ Thêm sinh viên</a></div>
<section class="panel"><form class="filter-bar" action="/students" method="get"><div class="search-field"><label class="sr-only" for="q">Tìm sinh viên</label><span aria-hidden="true">⌕</span><input id="q" name="q" value="<%= query.q || '' %>" placeholder="Mã sinh viên, họ tên, email..."></div><div class="filter-field"><label class="sr-only" for="class_id">Lọc theo lớp</label><select id="class_id" name="class_id"><option value="">Tất cả lớp học</option><option value="unassigned" <%= isSelected(query.class_id, 'unassigned') ? 'selected' : '' %>>Chưa xếp lớp</option><% classes.forEach(item => { %><option value="<%= item.id %>" <%= isSelected(query.class_id,item.id) ? 'selected' : '' %>><%= item.name %></option><% }) %></select></div><button class="button button-primary" type="submit">Tìm kiếm</button><% if (query.q || query.class_id) { %><a class="button button-light" href="/students">Xóa lọc</a><% } %></form><div class="list-summary"><strong>Danh sách sinh viên</strong><span><%= students.length %> kết quả</span></div><div class="table-wrap"><table><thead><tr><th>Sinh viên</th><th>Ngày sinh / Giới tính</th><th>Liên hệ</th><th>Lớp học</th><th>TB học tập</th><th class="text-right">Thao tác</th></tr></thead><tbody><% if (!students.length) { %><tr><td colspan="6"><div class="empty-state"><span aria-hidden="true">♙</span><strong>Không tìm thấy sinh viên</strong><p>Thử thay đổi bộ lọc hoặc thêm hồ sơ sinh viên mới.</p><a class="button button-light" href="/students/new">＋ Thêm sinh viên</a></div></td></tr><% } %><% students.forEach(student => { %><tr><td><div class="person"><span class="person-avatar" aria-hidden="true"><%= student.full_name.charAt(0) %></span><div><strong><%= student.full_name %></strong><span class="cell-subtext code-text"><%= student.student_code %></span></div></div></td><td><%= formatDate(student.dob) %><span class="cell-subtext"><%= student.gender || '—' %></span></td><td><%= student.email || '—' %><span class="cell-subtext"><%= student.phone || 'Chưa có số điện thoại' %></span></td><td><span class="badge badge-neutral"><%= student.class_name || 'Chưa xếp lớp' %></span></td><td><a class="score-link" href="/scores?student_id=<%= student.id %>" aria-label="Xem điểm của <%= student.full_name %>"><%= formatScore(student.total_average) %></a></td><td><div class="row-actions"><a class="button button-small button-light" href="/students/<%= student.id %>/edit" aria-label="Sửa sinh viên <%= student.full_name %>">Sửa</a><form action="/students/<%= student.id %>/delete" method="post" data-confirm="Bạn có chắc muốn xóa sinh viên <%= student.full_name %>? Hồ sơ có điểm số sẽ không thể xóa."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-danger" type="submit" aria-label="Xóa sinh viên <%= student.full_name %>">Xóa</button></form></div></td></tr><% }) %></tbody></table></div></section>
<div class="info-note"><span aria-hidden="true">ⓘ</span> Điểm trung bình học tập được tính theo số tín chỉ. Chọn điểm trung bình để xem bảng điểm của sinh viên.</div>
<%- include('../partials/footer') %>
