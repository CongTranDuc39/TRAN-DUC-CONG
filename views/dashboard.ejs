<%- include('partials/header') %>
<div class="page-heading"><div><div class="eyebrow">KHÔNG GIAN QUẢN LÝ</div><h1>Tổng quan hệ thống</h1><p>Theo dõi sinh viên, lớp học và kết quả học tập tại một nơi.</p></div><a class="button button-primary" href="/students/new"><span aria-hidden="true">＋</span> Thêm sinh viên</a></div>
<section class="stats-grid" aria-label="Thống kê hệ thống">
  <a class="stat-card" href="/students"><div class="stat-top"><span>Tổng sinh viên</span><span class="stat-icon icon-teal" aria-hidden="true">♙</span></div><strong class="stat-number"><%= stats.students %></strong><span class="stat-bottom">Hồ sơ đang quản lý <span aria-hidden="true">↗</span></span></a>
  <a class="stat-card" href="/classes"><div class="stat-top"><span>Lớp học</span><span class="stat-icon icon-blue" aria-hidden="true">▦</span></div><strong class="stat-number"><%= stats.classes %></strong><span class="stat-bottom">Tổ chức theo lớp <span aria-hidden="true">↗</span></span></a>
  <a class="stat-card" href="/subjects"><div class="stat-top"><span>Môn học</span><span class="stat-icon icon-purple" aria-hidden="true">▤</span></div><strong class="stat-number"><%= stats.subjects %></strong><span class="stat-bottom">Danh mục học phần <span aria-hidden="true">↗</span></span></a>
  <a class="stat-card" href="/scores"><div class="stat-top"><span>Bản ghi điểm</span><span class="stat-icon icon-amber" aria-hidden="true">▥</span></div><strong class="stat-number"><%= stats.scores %></strong><span class="stat-bottom">TB tổng kết: <b><%= formatScore(stats.average) %></b> <span aria-hidden="true">↗</span></span></a>
</section>
<section class="welcome-banner"><div><span class="eyebrow">QUẢN LÝ GỌN GÀNG, DỮ LIỆU RÕ RÀNG</span><h2>Sẵn sàng cho một ngày học tập mới.</h2><p>Cập nhật hồ sơ, phân lớp và theo dõi điểm số với những thao tác đơn giản.</p><div class="banner-actions"><a class="button button-white" href="/scores/new">Nhập điểm sinh viên <span aria-hidden="true">→</span></a><a class="banner-link" href="/classes">Khám phá lớp học <span aria-hidden="true">↗</span></a></div></div><div class="banner-art" aria-hidden="true"><span class="art-ring"></span><span class="art-book">A<span>+</span></span><span class="art-star">✦</span><span class="art-small-star">✧</span></div></section>
<div class="dashboard-grid">
  <section class="panel"><div class="panel-heading"><div><h2>Sinh viên mới nhất</h2><p>Những hồ sơ được thêm gần đây</p></div><a class="text-link" href="/students">Xem tất cả <span aria-hidden="true">→</span></a></div><div class="table-wrap"><table><thead><tr><th>Sinh viên</th><th>Mã sinh viên</th><th>Lớp học</th><th><span class="sr-only">Thao tác</span></th></tr></thead><tbody><% if (!recentStudents.length) { %><tr><td colspan="4"><div class="empty-state"><span aria-hidden="true">♙</span><strong>Chưa có sinh viên</strong><p>Thêm hồ sơ đầu tiên để bắt đầu quản lý.</p><a class="text-link" href="/students/new">Thêm sinh viên →</a></div></td></tr><% } %><% recentStudents.forEach(student => { %><tr><td><div class="person"><span class="person-avatar" aria-hidden="true"><%= student.full_name.charAt(0) %></span><strong><%= student.full_name %></strong></div></td><td><span class="code-text"><%= student.student_code %></span></td><td><span class="badge badge-neutral"><%= student.class_name || 'Chưa xếp lớp' %></span></td><td><a class="icon-link" href="/students/<%= student.id %>/edit" aria-label="Sửa sinh viên <%= student.full_name %>">↗</a></td></tr><% }) %></tbody></table></div></section>
  <section class="panel"><div class="panel-heading"><div><h2>Phân bố sinh viên</h2><p>Số lượng sinh viên theo lớp</p></div><span class="panel-icon" aria-hidden="true">▦</span></div><div class="class-distribution"><% if (!classStats.length) { %><div class="empty-state"><span aria-hidden="true">▦</span><strong>Chưa có lớp học</strong><p>Tạo lớp học để tổ chức danh sách sinh viên.</p><a class="text-link" href="/classes/new">Thêm lớp học →</a></div><% } %><% const largestClass = Math.max(1, ...classStats.map(item => Number(item.student_count))); %><% classStats.forEach(item => { %><div class="distribution-item"><div><span><%= item.name %></span><strong><%= item.student_count %> <small>SV</small></strong></div><progress value="<%= item.student_count %>" max="<%= largestClass %>" aria-label="<%= item.name %>: <%= item.student_count %> sinh viên"></progress><span class="distribution-code"><%= item.code %></span></div><% }) %></div></section>
</div>
<div class="dashboard-grid dashboard-bottom"><section class="panel"><div class="panel-heading"><div><h2>Kết quả học tập gần đây</h2><p>Điểm tổng kết được tính tự động theo thang 10</p></div><a class="text-link" href="/scores">Bảng điểm <span aria-hidden="true">→</span></a></div><div class="table-wrap"><table><thead><tr><th>Sinh viên</th><th>Môn học</th><th class="text-right">Tổng kết</th></tr></thead><tbody><% if (!recentScores.length) { %><tr><td colspan="3"><div class="empty-state compact"><strong>Chưa có kết quả học tập</strong><p>Nhập điểm để xem kết quả tổng kết tại đây.</p></div></td></tr><% } %><% recentScores.forEach(score => { %><tr><td><strong><%= score.full_name %></strong></td><td><%= score.subject_name %></td><td class="text-right"><span class="badge <%= Number(score.total_score) >= 5 ? 'badge-success' : 'badge-danger' %>"><%= formatScore(score.total_score) %></span></td></tr><% }) %></tbody></table></div></section><section class="panel quick-actions"><div class="panel-heading"><div><h2>Thao tác nhanh</h2><p>Tiếp tục công việc của bạn</p></div></div><a href="/classes/new"><span class="quick-icon icon-blue" aria-hidden="true">▦</span><span><strong>Tạo lớp học</strong><small>Sắp xếp sinh viên theo lớp</small></span><span aria-hidden="true">→</span></a><a href="/subjects/new"><span class="quick-icon icon-purple" aria-hidden="true">▤</span><span><strong>Thêm môn học</strong><small>Quản lý học phần và tín chỉ</small></span><span aria-hidden="true">→</span></a><a href="/scores/new"><span class="quick-icon icon-amber" aria-hidden="true">▥</span><span><strong>Nhập điểm</strong><small>Tự động tính điểm tổng kết</small></span><span aria-hidden="true">→</span></a></section></div>
<%- include('partials/footer') %>
