    {
      "id": 101,
      "title": "CPU container",
      "type": "timeseries",
      "description": "CPU thực tế từ cAdvisor, rate 5 phút; 100% tương ứng một lõi CPU. Ghép container ID với metadata Docker chỉ đọc để lấy đúng service thuộc project qlsv-trancong trên Docker Desktop/containerd.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * sum by (service) (label_replace(rate(container_cpu_usage_seconds_total{job=\"cadvisor\",image!=\"\"}[5m]), \"container_id\", \"$1\", \"id\", \".*([a-f0-9]{64}).*\") * on (container_id) group_left(service) qlsv_container_info{job=\"docker-metadata\",project=\"qlsv-trancong\"})",
          "instant": false,
          "range": true,
          "legendFormat": "{{service}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
