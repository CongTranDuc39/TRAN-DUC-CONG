{
  "name": "qlsv-trancong",
  "version": "1.0.0",
  "private": true,
  "description": "Hệ thống quản lý sinh viên - Trần Đức Công - Giai đoạn 1",
  "main": "app.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node scripts/integration-test.js",
    "test:proxy": "node scripts/proxy-test.js",
    "test:monitoring": "node scripts/monitoring-test.js",
    "test:logs": "node scripts/logging-test.js",
    "test:hardening": "node scripts/hardening-test.js",
    "test:final": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-final.ps1",
    "capture:logs": "node scripts/capture-logging-evidence.js",
    "capture:monitoring": "node scripts/capture-monitoring-evidence.js",
    "capture:final": "node scripts/capture-final-evidence.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.15.3",
    "prom-client": "^15.1.3"
  }
}
