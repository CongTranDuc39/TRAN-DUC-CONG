# Chỉ là mẫu: hãy tự đặt hai mật khẩu riêng, đủ dài trước khi chạy.
# Không commit file .env hoặc mật khẩu thật vào Git.
DB_NAME=qlsv
DB_USER=qlsv_app
DB_PASSWORD=REPLACE_WITH_A_RANDOM_APPLICATION_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_ROOT_PASSWORD

# Chỉ dùng khi chạy Node.js trực tiếp ngoài Docker.
# Trong Docker Compose, ứng dụng luôn kết nối đến service db:3306.
DB_HOST=127.0.0.1
DB_PORT=3306
PORT=3000
